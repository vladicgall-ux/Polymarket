# === Telegram ===
BOT_TOKEN=123456:ABC-your-bot-token
# Куда слать сигналы и кто может управлять ботом (user id / chat id через запятую)
TELEGRAM_CHAT_IDS=123456789

# === Стратегия ===
ORDER_SIZE_USDC=1.0
MAX_PRICE=0.01
MAX_OPEN_POSITIONS=10
MIN_TIME_TO_END_MINUTES=15
MAX_TIME_TO_END_HOURS=24
PREFILTER_PRICE=0.03

# === Фоновые задачи ===
SCAN_INTERVAL_SEC=60
RESOLUTION_CHECK_INTERVAL_SEC=120

# === Режим: signals | auto ===
TRADING_MODE=signals
# Для auto: приватный ключ Polygon-кошелька (НИКОГДА не коммитьте его)
PRIVATE_KEY=
# 0 = EOA (ключ сам держит USDC.e), 1 = Magic/email-аккаунт, 2 = браузерный кошелек (Phantom/MetaMask)
SIGNATURE_TYPE=0
# Для SIGNATURE_TYPE 1/2: адрес профиля Polymarket (proxy wallet, куда депонирован USDC)
FUNDER_ADDRESS=
# FOK = купить сразу на $1 целиком или ничего; GTC = лимитка по лучшему Ask
ORDER_TYPE=FOK

# === Прочее ===
DB_PATH=data/bot.db
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
GAMMA_MAX_RPS=4
CLOB_MAX_RPS=8
